{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bee.local/schemas/signalement.schema.json",
  "title": "Signalement",
  "description": "Fichier : signalements/S-<nnnn>.yaml (ruche-0118). Un membre signale deux comptes membres qu'il croit être une personne (bee signaler) : leurs deux logins et un motif d'une liste fermée, aucun texte libre. Le conseil seul ajoute sa décision (bee signalement) : lies (les deux fiches liées, ruche-0051) ou un code d'écart.",
  "type": "object",
  "additionalProperties": false,
  "required": ["par", "le", "comptes", "motif"],
  "properties": {
    "par": {"$ref": "#/$defs/login"},
    "le": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$(?!\\n)"},
    "comptes": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/login"}},
    "motif": {"enum": ["relectures_croisees", "votes_croises", "relais_d_engagements", "copie_de_contribution"]},
    "decision": {"type": "object", "additionalProperties": false, "required": ["par", "le", "issue"], "properties": {
      "par": {"$ref": "#/$defs/login"}, "le": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$(?!\\n)"},
      "issue": {"enum": ["lies", "sans_indice", "personnes_distinctes", "deja_lies", "doublon"]}}}
  },
  "$defs": {"login": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$(?!\\n)"}}
}
