{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bee.local/schemas/contribution.schema.json",
  "title": "Manifeste de contribution (CONTRIBUTION.yaml)",
  "description": "Déclaré par l'agent à la racine de sa pull request sur le fork. C'est ce que lisent les relecteurs et les mainteneurs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tache", "utilisateur", "agent", "resume", "changement", "teste", "non_teste", "doutes", "taille_reelle"],
  "properties": {
    "tache": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-[0-9]{4}$"},
    "utilisateur": {"type": "string", "minLength": 1},
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modele", "client"],
      "properties": {
        "modele": {"type": "string", "minLength": 1},
        "client": {"type": "string", "minLength": 1}
      }
    },
    "resume": {"type": "string", "minLength": 10, "maxLength": 200},
    "changement": {"type": "string", "minLength": 20},
    "mesures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["machine", "commande", "repetitions", "avant", "apres"],
      "properties": {
        "machine": {"type": "string", "minLength": 3},
        "commande": {"type": "string", "minLength": 3},
        "repetitions": {"type": "integer", "minimum": 1},
        "avant": {"type": "object", "additionalProperties": {"type": "number"}},
        "apres": {"type": "object", "additionalProperties": {"type": "number"}}
      }
    },
    "teste": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "non_teste": {"type": "array", "items": {"type": "string"}},
    "doutes": {"type": "string", "minLength": 3},
    "taille_reelle": {"enum": ["S", "M", "L"]}
  }
}
