{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bee.local/schemas/incidents.schema.json",
  "title": "Incidents (R13, brake)",
  "description": "File: governance/incidents.yaml, written by the council (docs/growth.md). An incident is open as long as it has no closed_at; while an incident is open, R13's brake is on: no approval, no sending, no reminder of an invitation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["incidents"],
  "properties": {
    "incidents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "opened_at"],
        "properties": {
          "id": {"type": "string", "pattern": "^INC-[0-9]{4}$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 300},
          "opened_at": {"type": "string"},
          "closed_at": {"type": "string"},
          "outcome": {"type": "string", "maxLength": 1500, "description": "What was done, at closing"}
        }
      }
    }
  }
}
