{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bee.local/schemas/enregistrement.schema.json",
  "title": "Enregistrement d'une contribution dans le registre",
  "description": "Fichier : contributions/<projet>/<tache>-c<n>.yaml. Créé par `bee soumettre`, complété par la CI (verdict), les relecteurs (relectures) et le workflow de confiance qui intègre automatiquement (R3, sans humain) et écarte les contributions concurrentes de la même tâche (statut « ecartee »).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "tache", "auteur", "pr", "statut", "soumise_le", "relectures"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-[0-9]{4}-c[0-9]+$"},
    "tache": {"type": "string"},
    "auteur": {"type": "string", "minLength": 1},
    "pr": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9-]+/[A-Za-z0-9_.-]+/pull/[0-9]+$"},
    "resume": {"type": "string"},
    "resume_sha": {"type": "string", "pattern": "^[0-9a-f]{7,40}$", "description": "Commit jugé (verdict.sha) pour lequel l'auteur a actualisé son résumé (bee soumettre --mettre-a-jour) : une mise à jour par commit jugé"},
    "statut": {"enum": ["en_relecture", "integree", "refusee", "annulee", "ecartee"]},
    "soumise_le": {"type": "string"},
    "engage_depuis": {"type": "string", "description": "Début de l'engagement de l'auteur sur la tâche (sa réservation ou son inscription en parallèle), contrôlé à la soumission ; R3 s'en sert dans les courses"},
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ci", "lignes_modifiees"],
      "properties": {
        "ci": {"enum": ["verte", "rouge"]},
        "etape_en_echec": {"type": "string"},
        "gain": {"type": ["number", "null"]},
        "au_dela_du_bruit": {"type": "boolean"},
        "lignes_modifiees": {"type": "integer", "minimum": 0},
        "ecart_declare": {"type": ["number", "null"]},
        "amorcage": {"type": "boolean"},
        "sha": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
        "execution": {"type": "string", "pattern": "^https://"},
        "degradations": {"type": "object", "additionalProperties": {"type": ["number", "null"]}},
        "instructions": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false,
          "properties": {"A": {"type": ["number", "null"]}, "B": {"type": ["number", "null"]}, "gain": {"type": ["number", "null"]}}}},
        "fichiers_controles": {"type": "boolean"},
        "juges_modifies": {"type": "array", "items": {"type": "string"}, "maxItems": 50},
        "juge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": {"type": ["integer", "null"]},
            "commun": {"type": ["string", "null"], "pattern": "^juge-v[0-9]{1,4}$"},
            "sorties_comparees": {"type": ["integer", "null"]},
            "constructions_suspectes": {"type": "array", "maxItems": 50, "items": {"type": "object", "additionalProperties": false,
              "required": ["type", "detail"], "properties": {"type": {"type": "string"}, "detail": {"type": "string"}}}}
          }
        }
      }
    },
    "relectures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relecteur", "avis", "motif", "le"],
        "properties": {
          "relecteur": {"type": "string", "minLength": 1},
          "avis": {"enum": ["favorable", "defavorable", "abstention"], "description": "abstention : motivée (diff hors d'atteinte, conflit d'intérêts, approche seulement) ; ni pour ni contre (R3, score), aucun point"},
          "motif": {"type": "string", "minLength": 10},
          "le": {"type": "string"},
          "defaut_signale": {"type": "boolean"},
          "defaut_confirme": {"type": "boolean"},
          "confirme_par": {"type": "string", "minLength": 1, "description": "Qui a confirmé le défaut : la CI, le conseil, un gardien ou un Confirmé, jamais le relecteur qui l'a signalé"},
          "sha": {"type": "string", "pattern": "^[0-9a-f]{7,40}$", "description": "Commit jugé relu (verdict.sha au moment de la relecture) ; absent avant le verdict : la relecture ne compte pas pour R3. Une relecture par relecteur et par commit"}
        }
      }
    },
    "motif_decision": {"type": "string"},
    "decidee_le": {"type": "string"},
    "fusion_sha": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "jamais_integree": {"const": true,
                        "description": "Statut « annulee » : close sans avoir jamais été intégrée (PR fermée sans fusion) ; ses relecteurs favorables ne perdent pas de point"},
    "retenue": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-[0-9]{4}-c[0-9]+$",
                "description": "Statut « ecartee » : la contribution concurrente de la même tâche retenue à sa place par R3"}
  },
  "allOf": [
    {
      "if": {"properties": {"statut": {"const": "ecartee"}}, "required": ["statut"]},
      "then": {"required": ["retenue", "decidee_le", "motif_decision"]},
      "else": {"not": {"required": ["retenue"]}}
    },
    {
      "if": {"properties": {"statut": {"const": "annulee"}}, "required": ["statut"]},
      "then": true,
      "else": {"not": {"required": ["jamais_integree"]}}
    }
  ]
}
