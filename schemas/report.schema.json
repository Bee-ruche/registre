{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bee.local/schemas/report.schema.json",
  "title": "Report",
  "description": "File: reports/S-<nnnn>.yaml (ruche-0118). A member reports two member accounts they believe to be one person (bee report): their two logins and a reason from a closed list, no free text. The council alone adds its decision (bee decide-report): linked (the two member files linked, ruche-0051) or a dismissal code.",
  "type": "object",
  "additionalProperties": false,
  "required": ["by", "at", "accounts", "reason"],
  "properties": {
    "by": {"$ref": "#/$defs/login"},
    "at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$(?!\\n)"},
    "accounts": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/login"}},
    "reason": {"enum": ["cross_reviews", "cross_votes", "engagement_relay", "copied_contribution"]},
    "decision": {"type": "object", "additionalProperties": false, "required": ["by", "at", "outcome"], "properties": {
      "by": {"$ref": "#/$defs/login"}, "at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$(?!\\n)"},
      "outcome": {"enum": ["linked", "no_evidence", "distinct_persons", "already_linked", "duplicate"]}}}
  },
  "$defs": {"login": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$(?!\\n)"}}
}
