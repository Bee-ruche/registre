{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bee.local/schemas/task.schema.json",
  "title": "Tâche Bee",
  "description": "Une unité de travail autonome, lisible par un agent sans mémoire. Fichier : taches/<projet>/<id>.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "project", "category", "type", "size", "title", "context", "files", "reach", "metric", "acceptance_criteria", "out_of_scope", "status", "created_by", "created_on"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-[0-9]{4}$"},
    "project": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "category": {"type": "string"},
    "type": {"enum": ["optimization", "review", "measurement", "test", "split"]},
    "area": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "R11 : poste du cap de la ruche (gouvernance, projets, coordination…) ; défaut d'après le type (docs/cap.md)"},
    "size": {"enum": ["S", "M", "L"]},
    "title": {"type": "string", "minLength": 5, "maxLength": 100},
    "context": {"type": "string", "minLength": 40},
    "files": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "reach": {"type": "number", "minimum": 0.1, "maximum": 1},
    "metric": {"type": ["string", "null"]},
    "compressed_output": {"enum": ["identical", "may_change"]},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
    "out_of_scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "depends_on": {"type": "array", "items": {"type": "string"}},
    "node": {"type": "string", "pattern": "^(root|[a-z0-9]+(-[a-z0-9]+)*(/[a-z0-9]+(-[a-z0-9]+)*)*)$", "description": "Nœud de l'arbre du sens auquel la tâche se rattache, s'il est plus précis que celui de son projet (une zone : projets/compression-sans-perte/miniz/tinfl) ; défaut : arbre/projets/<categorie>/<projet>/ (docs/arbre.md)"},
    "status": {"enum": ["proposed", "open", "reserved", "in_review", "integrated", "refused", "abandoned"]},
    "reservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user", "since"],
      "properties": {
        "user": {"type": "string", "minLength": 1},
        "since": {"type": "string"}
      }
    },
    "parallel": {
      "type": "array",
      "minItems": 1,
      "description": "R11 : inscriptions en parallèle (bee prendre --en-parallele) ; d'autres abeilles travaillent sur la tâche, au su de tous, sans toucher à la réservation du titulaire. Seulement si la tâche est réservée ou en relecture",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["user", "since"],
        "properties": {
          "user": {"type": "string", "minLength": 1},
          "since": {"type": "string"}
        }
      }
    },
    "contribution": {"type": "string", "description": "Dernière contribution soumise ; une fois la tâche intégrée, la contribution retenue (R3)"},
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["by", "at", "text"],
        "properties": {
          "by": {"type": "string"},
          "at": {"type": "string"},
          "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "created_by": {"type": "string", "minLength": 1},
    "created_on": {"type": "string", "format": "date"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "reserved"}}, "required": ["status"]},
      "then": {"required": ["reservation"]},
      "else": {"not": {"required": ["reservation"]}}
    },
    {
      "if": {"properties": {"status": {"enum": ["in_review", "integrated"]}}, "required": ["status"]},
      "then": {"required": ["contribution"]}
    },
    {
      "if": {"properties": {"status": {"enum": ["reserved", "in_review"]}}, "required": ["status"]},
      "then": true,
      "else": {"not": {"required": ["parallel"]}}
    },
    {
      "if": {"properties": {"type": {"const": "optimization"}}, "required": ["type"]},
      "then": {"properties": {"metric": {"type": "string"}}}
    },
    {
      "if": {"properties": {"type": {"const": "split"}}, "required": ["type"]},
      "then": {"properties": {"size": {"const": "L"}}}
    }
  ]
}
