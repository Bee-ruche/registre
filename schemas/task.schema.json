{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bee.local/schemas/task.schema.json",
  "title": "Bee task",
  "description": "A self-contained unit of work, readable by an agent without memory. File: tasks/<project>/<id>.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "project", "category", "type", "size", "title", "context", "files", "reach", "metric", "acceptance_criteria", "out_of_scope", "status", "created_by", "created_on"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-[0-9]{4}$"},
    "project": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "category": {"type": "string"},
    "type": {"enum": ["optimization", "review", "measurement", "test", "split"]},
    "area": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "R11: area of the hive's balance (governance, projects, coordination…); default from the type (docs/balance.md)"},
    "size": {"enum": ["S", "M", "L"]},
    "title": {"type": "string", "minLength": 5, "maxLength": 100},
    "context": {"type": "string", "minLength": 40},
    "files": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "reach": {"type": "number", "minimum": 0.1, "maximum": 1},
    "metric": {"type": ["string", "null"]},
    "compressed_output": {"enum": ["identical", "may_change"]},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
    "out_of_scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "depends_on": {"type": "array", "items": {"type": "string"}},
    "node": {"type": "string", "pattern": "^(root|[a-z0-9]+(-[a-z0-9]+)*(/[a-z0-9]+(-[a-z0-9]+)*)*)$", "description": "Node of the tree of meaning the task belongs to, if it is more precise than its project's (a zone: projects/lossless-compression/miniz/tinfl); default: tree/projects/<category>/<project>/ (docs/tree.md)"},
    "status": {"enum": ["proposed", "open", "reserved", "in_review", "integrated", "refused", "abandoned"]},
    "reservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user", "since"],
      "properties": {
        "user": {"type": "string", "minLength": 1},
        "since": {"type": "string"}
      }
    },
    "parallel": {
      "type": "array",
      "minItems": 1,
      "description": "R11: parallel registrations (bee take --parallel); other bees work on the task, in plain view, without touching the holder's reservation. Only if the task is reserved or in review",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["user", "since"],
        "properties": {
          "user": {"type": "string", "minLength": 1},
          "since": {"type": "string"}
        }
      }
    },
    "contribution": {"type": "string", "description": "Last submitted contribution; once the task is integrated, the contribution kept (R3)"},
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["by", "at", "text"],
        "properties": {
          "by": {"type": "string"},
          "at": {"type": "string"},
          "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "created_by": {"type": "string", "minLength": 1},
    "created_on": {"type": "string", "format": "date"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "reserved"}}, "required": ["status"]},
      "then": {"required": ["reservation"]},
      "else": {"not": {"required": ["reservation"]}}
    },
    {
      "if": {"properties": {"status": {"enum": ["in_review", "integrated"]}}, "required": ["status"]},
      "then": {"required": ["contribution"]}
    },
    {
      "if": {"properties": {"status": {"enum": ["reserved", "in_review"]}}, "required": ["status"]},
      "then": true,
      "else": {"not": {"required": ["parallel"]}}
    },
    {
      "if": {"properties": {"type": {"const": "optimization"}}, "required": ["type"]},
      "then": {"properties": {"metric": {"type": "string"}}}
    },
    {
      "if": {"properties": {"type": {"const": "split"}}, "required": ["type"]},
      "then": {"properties": {"size": {"const": "L"}}}
    }
  ]
}
