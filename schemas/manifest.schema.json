{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bee.local/schemas/manifest.schema.json",
  "title": "Contribution manifest (CONTRIBUTION.yaml)",
  "description": "Declared by the agent at the root of its pull request on the fork. It is what reviewers and maintainers read.",
  "type": "object",
  "additionalProperties": false,
  "required": ["task", "user", "agent", "summary", "change", "tested", "untested", "doubts", "actual_size"],
  "properties": {
    "task": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-[0-9]{4}$"},
    "user": {"type": "string", "minLength": 1},
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "client"],
      "properties": {
        "model": {"type": "string", "minLength": 1, "description": "Copied at the verdict into the record (declared, 200 characters at most), with the declared gain, tested, untested and doubts"},
        "client": {"type": "string", "minLength": 1}
      }
    },
    "summary": {"type": "string", "minLength": 10, "maxLength": 200},
    "change": {"type": "string", "minLength": 20},
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["machine", "command", "repetitions", "before", "after"],
      "properties": {
        "machine": {"type": "string", "minLength": 3},
        "command": {"type": "string", "minLength": 3},
        "repetitions": {"type": "integer", "minimum": 1},
        "before": {"type": "object", "additionalProperties": {"type": "number"}, "description": "Metrics of the project, and instructions_<scenario> (the instructions key of a metric of projects/*.yaml), on which R4 judges"},
        "after": {"type": "object", "additionalProperties": {"type": "number"}}
      }
    },
    "tested": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "untested": {"type": "array", "items": {"type": "string"}},
    "doubts": {"type": "string", "minLength": 3},
    "actual_size": {"enum": ["S", "M", "L"]}
  }
}
