#!/usr/bin/env bash
# Opens an "on paper" PR on the project's simulated fork: returns an address and records its author.
# Usage (from your clone of the simulation): open-fork-pr <login> <project> "<short description of the approach>"
set -euo pipefail
source "$(dirname "$(realpath "$0")")/common.sh"
case "${1:-}" in -h|--help|"") echo 'usage: open-fork-pr <login> <project> "<description>"' >&2; exit 2;; esac
login="${1:?login}"; project="${2:?project}"; desc="${3:-}"
in_own_clone "$login"; valid_text "$desc"
case "$project" in miniz) repo=minizBee;; libyaml) repo=libyamlBee;; ruche) repo=registre;; *) echo "unknown project: $project" >&2; exit 1;; esac
exec 9>"$SIM/state/verrou"; flock 9
n=$(( $(cat "$SIM/state/compteur_pr_fork" 2>/dev/null || echo 9000) + 1 )); echo "$n" > "$SIM/state/compteur_pr_fork"
url="https://github.com/Bee-ruche/$repo/pull/$n"
printf '%s\t%s\t%s\n' "$url" "$login" "$desc" >> "$SIM/state/prs_fork.tsv"
echo "$url"
