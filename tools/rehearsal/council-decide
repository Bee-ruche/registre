#!/usr/bin/env bash
# Le conseil simulé décide d'une PR réservée au conseil (code 3 de verifier-pr) : il la fusionne ou la refuse.
# Usage : decider-conseil <numéro> fusionner|refuser "<motif>"
# La validation passe par l'outil de main (le code de confiance), jamais par celui de la PR jugée.
set -euo pipefail
source "$(dirname "$(realpath "$0")")/common.sh"
case "${1:-}" in -h|--help|"") echo 'usage : council-decide <numéro> fusionner|refuser "<reason>"' >&2; exit 2;; esac
n="${1:?numéro}"; decision="${2:?fusionner ou refuser}"; reason="${3:-}"
[[ "$n" =~ ^[0-9]+$ ]] || { echo "numéro de PR invalide : $n" >&2; exit 2; }
case "$decision" in merge|refuse) ;; *) echo "décision : fusionner ou refuser" >&2; exit 2;; esac
valid_text "${reason:-sans motif}"
export BEE_NOW="$(python3 "$SIM/tools/clock.py")"
exec 9>"$SIM/state/verrou"; flock 9
conf="$SIM/trust"
git -C "$conf" fetch -q origin "refs/heads/pr/$n:refs/remotes/origin/pr/$n" 2>/dev/null || { echo "PR $n inconnue" >&2; exit 1; }
git -C "$conf" fetch -q origin && git -C "$conf" checkout -q --detach origin/main
# Le conseil ne décide que des PR que l'outil de main a jugées valides et réservées au conseil (état « conseil »).
last=$(awk -F'\t' -v n="$n" '$2==n {e=$5} END {print e}' "$SIM/state/prs.tsv")
[ "$last" = council ] || { echo "PR $n : état « ${last:-inconnu} », pas en attente du conseil ; rien à décider." >&2; exit 1; }
if [ "$decision" = refuse ]; then
  printf '%s\t%s\t%s\t%s\t%s\n' "$BEE_NOW" "$n" "council" "décision : $reason" "refusee_conseil" >> "$SIM/state/prs.tsv"
  echo "PR $n refusée par le conseil."; exit 0
fi
rm -rf "$SIM/merge"; git -C "$conf" worktree prune
git -C "$conf" worktree add -q --detach "$SIM/merge" origin/main
if ! git -C "$SIM/merge" -c user.name=council -c user.email=council@simu.bee merge -q --no-edit --no-ff "origin/pr/$n" >/dev/null 2>&1; then
  echo "PR $n : conflit avec main ; l'auteur doit la refaire."; git -C "$SIM/merge" merge --abort 2>/dev/null || true
  git -C "$conf" worktree remove --force "$SIM/merge"; exit 1
fi
if ! python3 "$conf/tools/bee.py" --registry "$SIM/merge" validate >/dev/null 2>&1; then
  echo "PR $n : le registre ne serait plus valide ; refusée."; git -C "$conf" worktree remove --force "$SIM/merge"; exit 1
fi
BEE_SIM_ROBOT=1 git -C "$SIM/merge" push -q origin HEAD:main
printf '%s\t%s\t%s\t%s\t%s\n' "$BEE_NOW" "$n" "council" "décision : $reason" "fusionnee_conseil" >> "$SIM/state/prs.tsv"
git -C "$conf" worktree remove --force "$SIM/merge"
echo "PR $n fusionnée par le conseil."
