#!/usr/bin/env bash
# Pousse un commit « sur papier » sur sa PR du fork simulé, puis la CI simulée du fork rend son verdict.
# Usage (depuis son clone de la simulation) : pousser-pr-fork <pseudo> <url_pr_fork> <manifeste.yaml> "<ce que contient ce commit>"
# Le manifeste est celui que la CI lirait dans manifestes/<tâche>.yaml du fork, à ce commit.
# Le code d'un commit, c'est sa description : la même qu'un commit précédent donne les mêmes décomptes d'instructions
# (seul le chronomètre varie). Son arbre, c'est la description et le manifeste : changer l'un ou l'autre change l'arbre.
set -euo pipefail
source "$(dirname "$(realpath "$0")")/common.sh"
case "${1:-}" in -h|--help|"") echo 'usage : push-fork-pr <login> <url_pr_fork> <manifest.yaml> "<ce que contient ce commit>"' >&2; exit 2;; esac
login="${1:?login}"; url="${2:?url}"; manifest="${3:?manifest}"; desc="${4:-}"
in_own_clone "$login"; valid_text "$desc"
[[ "$url" =~ ^https://github\.com/Bee-ruche/[A-Za-z]+/pull/[0-9]+$ ]] || { echo "adresse de PR invalide : $url" >&2; exit 2; }
if ! awk -F'\t' -v u="$url" -v p="$login" '$1==u && $2==p {ok=1} END {exit !ok}' "$SIM/state/prs_fork.tsv"; then
  echo "La PR $url n'est pas à vous (open-fork-pr d'abord)." >&2; exit 1
fi
[ -f "$manifest" ] || { echo "manifeste introuvable : $manifest" >&2; exit 1; }
python3 -c 'import sys, yaml; m = yaml.safe_load(open(sys.argv[1], encoding="utf-8")); sys.exit(0 if isinstance(m, dict) and isinstance(m.get("task"), str) else 1)' "$manifest" \
  || { echo "manifeste refusé : un fichier YAML avec au moins un champ tache (voir docs/contributions.md)" >&2; exit 1; }
exec 9>"$SIM/state/verrou"; flock 9
number_of="${url##*/}"; mkdir -p "$SIM/state/manifests/$number_of"
k=$(( $(ls "$SIM/state/manifests/$number_of" | wc -l) + 1 ))
sha=$(printf '%s:%s' "$url" "$k" | sha1sum | cut -c1-40)
tree=$( { printf '%s\n' "$desc"; cat "$manifest"; } | sha1sum | cut -c1-40)
cp "$manifest" "$SIM/state/manifests/$number_of/$sha.yaml"
printf '%s\t%s\t%s\t%s\t%s\n' "$(python3 "$SIM/tools/clock.py")" "$url" "$sha" "$tree" "$desc" >> "$SIM/state/commits_fork.tsv"
echo "Commit $sha poussé sur $url. CI du fork :"
python3 "$SIM/tools/simulated_ci.py" "$url"
