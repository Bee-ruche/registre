#!/usr/bin/env bash
# Reruns the fork's simulated CI on the last commit of a PR (after a late submission). A rerun gives the same
# instruction counts (same content) and a new draw of the stopwatch, like a real rerun.
# Usage: simulated-ci <fork_pr_url>
set -euo pipefail
source "$(dirname "$(realpath "$0")")/common.sh"
case "${1:-}" in -h|--help|"") echo 'usage: simulated-ci <fork_pr_url>' >&2; exit 2;; esac
url="${1:?url}"
[[ "$url" =~ ^https://github\.com/Bee-ruche/[A-Za-z]+/pull/[0-9]+$ ]] || { echo "invalid PR address: $url" >&2; exit 2; }
exec 9>"$SIM/state/verrou"; flock 9
exec python3 "$SIM/tools/simulated_ci.py" "$url" --rerun
