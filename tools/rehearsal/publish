#!/usr/bin/env bash
# Publie les changements du clone courant sur le registre simulé, comme bee publier + fusion-auto :
# vérification par l'outil de main (code de confiance), fusion si le code est 0, file du conseil si 3.
# Usage (depuis son clone de la simulation) : publier <pseudo> "<titre>"
set -euo pipefail
source "$(dirname "$(realpath "$0")")/common.sh"
case "${1:-}" in -h|--help|"") echo 'usage : publier <login> "<title>"' >&2; exit 2;; esac
login="${1:?login}"; title="${2:?title}"
in_own_clone "$login"; valid_text "$title"
clone="$(git rev-parse --show-toplevel)"
export BEE_NOW="$(python3 "$SIM/tools/clock.py")"
cd "$clone"
git add -A
if ! git diff --cached --quiet; then
  git -c user.name="$login" -c user.email="$login@simu.bee" commit -qm "$title"
elif [ "$(git rev-list --count origin/main..HEAD)" = 0 ]; then
  echo "rien à publier" >&2; exit 1
fi   # sinon : republier le commit gardé après un refus (ou corrigé depuis)
exec 9>"$SIM/state/verrou"; flock 9
n=$(( $(cat "$SIM/state/compteur_pr" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$SIM/state/compteur_pr"
BEE_SIM_ROBOT=1 git push -q "$SIM/central.git" "HEAD:refs/heads/pr/$n"
conf="$SIM/trust"
git -C "$conf" fetch -q origin && git -C "$conf" checkout -q --detach origin/main
rm -rf "$SIM/merge"; git -C "$conf" worktree prune
git -C "$conf" fetch -q origin "refs/heads/pr/$n:refs/remotes/origin/pr/$n"
git -C "$conf" worktree add -q --detach "$SIM/merge" origin/main
if ! git -C "$SIM/merge" -c user.name=robot -c user.email=robot@simu.bee merge -q --no-edit --no-ff "origin/pr/$n" >/dev/null 2>&1; then
  echo "PR $n : conflit avec main (mettez votre clone à jour : git pull, puis refaites l'action)."
  printf '%s\t%s\t%s\t%s\tconflit\n' "$BEE_NOW" "$n" "$login" "$title" >> "$SIM/state/prs.tsv"
  git -C "$SIM/merge" merge --abort 2>/dev/null || true; exit 1
fi
awk -F'\t' '{print $1"\t"$2}' "$SIM/state/prs_fork.tsv" > "$SIM/state/pr_authors.tsv" 2>/dev/null || : > "$SIM/state/pr_authors.tsv"
set +e
output_text=$(python3 "$conf/tools/bee.py" --registry "$SIM/merge" check-pr --base origin/main --head HEAD \
  --author "$login" --account-created-on 2024-01-01 --pr-authors "$SIM/state/pr_authors.tsv" --auto-merge 2>&1)
code=$?
set -e
echo "$output_text"
case "$code" in
  0) BEE_SIM_ROBOT=1 git -C "$SIM/merge" push -q origin HEAD:main; echo "PR $n fusionnée automatiquement."; state=fusionnee;;
  3) echo "PR $n valide, mais réservée au conseil : elle attend sa décision."; state=council;;
  *) echo "PR $n refusée."; state=refused;;
esac
printf '%s\t%s\t%s\t%s\t%s\n' "$BEE_NOW" "$n" "$login" "$title" "$state" >> "$SIM/state/prs.tsv"
git -C "$conf" worktree remove --force "$SIM/merge" 2>/dev/null || true
cd "$clone"; git fetch -q origin
if [ "$state" = refused ]; then
  echo "Votre commit reste dans votre clone : corrigez puis republiez, ou abandonnez-le (git reset --hard origin/main)."
  exit 1
fi
git reset -q --hard origin/main
