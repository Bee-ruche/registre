#!/usr/bin/env bash
# Le gh de la ruche simulée : il refuse tout, pour qu'aucune commande de la simulation n'atteigne le vrai GitHub.
# ruche-0122 : sauf la lecture groupée des PR des forks (gh api graphql, celle de bee en-attente --pr-states), servie depuis
# etat/prs_fork.tsv (auteur) et etat/commits_fork.tsv (tête : le dernier commit poussé) ; une PR sans commit n'a pas de réponse.
# Elle ne répond que OPEN (CLOSED et MERGED sont couverts par le faux gh des tests unitaires), toujours d'un compte
# utilisateur, au numéro simulé (crc32 du login).
# Chaque appel, servi ou refusé, s'ajoute à etat/appels_gh.tsv (sa commande, puis son code).
if [ -n "${BEE_SIM:-}" ] && [ -d "$BEE_SIM/state" ] && [ "${1:-} ${2:-} ${3:-}" = "api graphql -f" ]; then
  python3 - "$BEE_SIM/state" "${4#query=}" <<'EOF'
import json, pathlib, re, sys, zlib
state, query_text = pathlib.Path(sys.argv[1]), sys.argv[2]
lines = lambda name: [l.split("\t") for l in (state / name).read_text(encoding="utf-8").splitlines()] if (state / name).exists() else []
authors = {l[0]: l[1] for l in lines("prs_fork.tsv") if len(l) >= 2}
heads = {l[1]: l[2] for l in lines("commits_fork.tsv") if len(l) >= 3}
data, repo = {}, None
for m in re.finditer(r'(r\d+): repository\(owner: "([^"]*)", name: "([^"]*)"\)|(p\d+): pullRequest\(number: (\d+)\)', query_text):
    if m[1]:
        repo = data.setdefault(m[1], {}), f"https://github.com/{m[2]}/{m[3]}/pull/"
    elif repo:
        url = repo[1] + m[5]
        repo[0][m[4]] = {"state": "OPEN", "headRefOid": heads[url], "mergeCommit": None,
                          "author": {"__typename": "User", "login": authors[url],
                                     "databaseId": zlib.crc32(authors[url].encode()) + 1}} if url in authors and url in heads else None
manque = sum(v is None for r in data.values() for v in r.values())
print(json.dumps({"data": data, **({"errors": [{"message": f"{manque} PR sans réponse"}]} if manque else {})}))
sys.exit(1 if manque or not data else 0)
EOF
  code=$?
  printf 'api graphql\t%s\n' "$code" >> "$BEE_SIM/state/appels_gh.tsv"
  exit "$code"
fi
[ -n "${BEE_SIM:-}" ] && [ -d "$BEE_SIM/state" ] && printf '%s\t1\n' "$(printf '%s ' "$@" | tr -d '\t\n' | cut -c1-200)" >> "$BEE_SIM/state/appels_gh.tsv"
echo "gh est désactivé dans la ruche simulée (appel refusé : gh $*). Voir LISEZMOI.md pour les gestes simulés." >&2
exit 1
