#!/usr/bin/env bash
# The simulated hive's bee tool: the simulated clock (state/clock) is applied at each call.
# Run it from your own clone of the simulated registry. Nothing goes to GitHub: `bee publish` is replaced by
# `publish`, and the simulation's `gh` refuses everything.
set -euo pipefail
source "$(dirname "$(realpath "$0")")/common.sh"
if printf '%s\n' "$@" | grep -qx publish; then
  echo "In the simulated hive, publish with: publish <your login> \"<title>\" (see README.md)." >&2; exit 2
fi
export BEE_NOW="$(python3 "$SIM/tools/clock.py")"
export PATH="$SIM/tools:$PATH"   # the fake gh first, even if the caller changed their PATH
root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
case "$(realpath -m "${root:-/}")/" in
  "$SIM"/bees/*/registre/) ;;
  *) echo "Run bee from your clone of the simulation ($SIM/bees/<login>/registre)." >&2; exit 2;;
esac
exec python3 "$root/tools/bee.py" --registry "$root" "$@"
