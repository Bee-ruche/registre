#!/usr/bin/env bash
# Outil bee de la ruche simulée : l'horloge simulée (etat/horloge) est appliquée à chaque appel.
# À lancer depuis son propre clone du registre simulé. Rien ne part vers GitHub : `bee publier` est remplacé par
# `publier`, et le `gh` de la simulation refuse tout.
set -euo pipefail
source "$(dirname "$(realpath "$0")")/commun.sh"
if [ "${1:-}" = publier ]; then
  echo "Dans la ruche simulée, publiez avec : publier <votre pseudo> \"<titre>\" (voir LISEZMOI.md)." >&2; exit 2
fi
export BEE_MAINTENANT="$(python3 "$SIMU/outils/horloge.py")"
export PATH="$SIMU/outils:$PATH"   # le faux gh d'abord, même si l'appelant a changé son PATH
racine="$(git rev-parse --show-toplevel 2>/dev/null || true)"
case "$(realpath -m "${racine:-/}")/" in
  "$SIMU"/abeilles/*/registre/) ;;
  *) echo "Lancez bee depuis votre clone de la simulation ($SIMU/abeilles/<pseudo>/registre)." >&2; exit 2;;
esac
exec python3 "$racine/outils/bee.py" --registre "$racine" "$@"
