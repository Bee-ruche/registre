#!/usr/bin/env bash
# Ouvre une PR « sur papier » sur le fork simulé du projet : rend une adresse et enregistre son auteur.
# Usage (depuis son clone de la simulation) : ouvrir-pr-fork <pseudo> <projet> "<description courte de l'approche>"
set -euo pipefail
source "$(dirname "$(realpath "$0")")/commun.sh"
case "${1:-}" in -h|--help|"") echo 'usage : ouvrir-pr-fork <pseudo> <projet> "<description>"' >&2; exit 2;; esac
pseudo="${1:?pseudo}"; projet="${2:?projet}"; desc="${3:-}"
dans_son_clone "$pseudo"; texte_valide "$desc"
case "$projet" in miniz) depot=minizBee;; libyaml) depot=libyamlBee;; ruche) depot=registre;; *) echo "projet inconnu : $projet" >&2; exit 1;; esac
exec 9>"$SIMU/etat/verrou"; flock 9
n=$(( $(cat "$SIMU/etat/compteur_pr_fork" 2>/dev/null || echo 9000) + 1 )); echo "$n" > "$SIMU/etat/compteur_pr_fork"
url="https://github.com/Bee-ruche/$depot/pull/$n"
printf '%s\t%s\t%s\n' "$url" "$pseudo" "$desc" >> "$SIMU/etat/prs_fork.tsv"
echo "$url"
